<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sweet Shop Admin - Cake options</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-page">
  <%- include('includes/header') %>

  <main class="container products-page">
    <div class="page-heading">
      <div>
        <p class="eyebrow">Admin panel</p>
        <h1>Cake Options</h1>
        <p class="page-description">Manage builder ingredients, decorations, preview metadata, and price modifiers.</p>
      </div>
    </div>

    <section class="cake-option-create">
      <h2>Add cake option</h2>
      <% if (createError) { %>
        <div class="create-form-error" role="alert"><%= createError %></div>
      <% } %>
      <form action="/admin/cake-options/create" method="POST" class="cake-option-form">
        <label>Type
          <select name="optionType" required>
            <% optionTypes.forEach(function(type) { %>
              <option value="<%= type %>" <%= formData.optionType === type ? 'selected' : '' %>><%= type %></option>
            <% }); %>
          </select>
        </label>
        <label>Code
          <input name="code" value="<%= formData.code || '' %>" pattern="[A-Za-z0-9_-]{2,40}" required>
        </label>
        <label>Name
          <input name="name" value="<%= formData.name || '' %>" required>
        </label>
        <label>Price modifier
          <input type="number" name="priceModifier" min="0" step="0.01" value="<%= formData.priceModifier ?? 0 %>" required>
        </label>
        <label>Sort order
          <input type="number" name="sortOrder" min="0" step="1" value="<%= formData.sortOrder ?? 0 %>" required>
        </label>
        <label>Preview color
          <input name="previewColor" value="<%= formData.previewColor || '' %>" placeholder="#C98B62">
        </label>
        <label class="cake-option-form__wide">Preview image
          <input name="previewImage" value="<%= formData.previewImage || '' %>" placeholder="uploads/example.png">
        </label>
        <label class="cake-option-form__wide">Description
          <textarea name="description"><%= formData.description || '' %></textarea>
        </label>
        <button class="btn-create" type="submit">Create option</button>
      </form>
    </section>

    <section class="cake-option-list">
      <% if (options.length === 0) { %>
        <div class="my-orders-state">No cake options have been created yet.</div>
      <% } %>
      <% options.forEach(function(option) { %>
        <article class="cake-option-card">
          <div class="cake-option-card__preview" style="--option-color: <%= option.previewColor || '#ead8c5' %>">
            <% if (option.previewImage) { %><img src="/<%= option.previewImage.replace(/^\//, '') %>" alt=""><% } %>
          </div>
          <form action="/admin/cake-options/<%= option._id %>/update" method="POST" class="cake-option-card__form">
            <select name="optionType" aria-label="Option type">
              <% optionTypes.forEach(function(type) { %>
                <option value="<%= type %>" <%= option.optionType === type ? 'selected' : '' %>><%= type %></option>
              <% }); %>
            </select>
            <input name="code" value="<%= option.code %>" aria-label="Code" required>
            <input name="name" value="<%= option.name %>" aria-label="Name" required>
            <input type="number" name="priceModifier" value="<%= option.priceModifier %>" min="0" step="0.01" aria-label="Price modifier" required>
            <input type="number" name="sortOrder" value="<%= option.sortOrder %>" min="0" step="1" aria-label="Sort order" required>
            <input name="previewColor" value="<%= option.previewColor || '' %>" aria-label="Preview color" placeholder="Preview color">
            <input name="previewImage" value="<%= option.previewImage || '' %>" aria-label="Preview image" placeholder="Preview image">
            <textarea name="description" aria-label="Description" placeholder="Description"><%= option.description || '' %></textarea>
            <button class="btn-primary" type="submit">Save</button>
          </form>
          <form action="/admin/cake-options/<%= option._id %>/status" method="POST" class="cake-option-card__status">
            <input type="hidden" name="isActive" value="<%= option.isActive ? 'false' : 'true' %>">
            <span class="status-badge <%= option.isActive ? 'status-active' : 'status-delete' %>"><%= option.isActive ? 'Active' : 'Inactive' %></span>
            <button type="submit" class="btn-status-toggle"><%= option.isActive ? 'Deactivate' : 'Activate' %></button>
          </form>
        </article>
      <% }); %>
    </section>
  </main>
</body>
</html>
