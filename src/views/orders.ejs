<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sweet Shop Admin - Orders</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-page">
  <%- include('includes/header') %>

  <%
    const orderStatusLabels = {
      PENDING: 'Pending',
      CONFIRMED: 'Confirmed',
      BAKING: 'Baking',
      DECORATING: 'Decorating',
      OUT_FOR_DELIVERY: 'Out for delivery',
      DELIVERED: 'Delivered',
      CANCELLED: 'Cancelled',
      PROCESS: 'Legacy processing',
    };
    const orderStatusTransitions = {
      PENDING: ['CONFIRMED', 'CANCELLED'],
      PROCESS: ['CONFIRMED'],
      CONFIRMED: ['BAKING', 'CANCELLED'],
      BAKING: ['DECORATING', 'CANCELLED'],
      DECORATING: ['OUT_FOR_DELIVERY', 'CANCELLED'],
      OUT_FOR_DELIVERY: ['DELIVERED'],
      DELIVERED: [],
      CANCELLED: [],
    };
  %>

  <main class="container products-page">
    <div class="page-heading">
      <div>
        <p class="eyebrow">Admin panel</p>
        <h1>Order Management</h1>
        <p class="page-description">Review customer orders and update their status.</p>
      </div>
    </div>

    <div id="order-message" class="order-message" role="status" hidden></div>

    <div class="table-card">
      <div class="table-scroll">
        <table class="products-table orders-table">
          <thead>
            <tr>
              <th>Customer</th>
              <th>Phone</th>
              <th>Items</th>
              <th>Total</th>
              <th>Status</th>
              <th>Created at</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (orders.length === 0) { %>
              <tr><td colspan="7" class="empty-table">No orders found yet.</td></tr>
            <% } %>
            <% orders.forEach(function(order) { %>
              <tr>
                <td>
                  <strong><%= order.customerName %></strong><br>
                  <small><%= order.address %></small>
                  <% if (order.deliveryDate) { %>
                    <div class="order-delivery-window">
                      <strong><%= order.deliveryDate %></strong>
                      <span><%= order.deliveryStartTime %>–<%= order.deliveryEndTime %></span>
                    </div>
                  <% } %>
                </td>
                <td><a href="tel:<%= order.phone %>"><%= order.phone %></a></td>
                <td>
                  <% order.items.forEach(function(item) { %>
                    <div><%= item.productName %> × <%= item.quantity %></div>
                  <% }); %>
                </td>
                <td>$<%= Number(order.total).toFixed(2) %></td>
                <td>
                  <span id="status-<%= order._id %>" class="status-badge status-<%= order.orderStatus.toLowerCase().replaceAll('_', '-') %>">
                    <%= orderStatusLabels[order.orderStatus] || order.orderStatus %>
                  </span>
                  <details class="order-history">
                    <summary>History (<%= order.statusHistory?.length || 0 %>)</summary>
                    <ol id="history-<%= order._id %>">
                      <% (order.statusHistory || []).forEach(function(entry) { %>
                        <li>
                          <strong><%= orderStatusLabels[entry.status] || entry.status %></strong>
                          <span><%= entry.source %> · <%= new Date(entry.changedAt).toLocaleString('en-GB') %></span>
                        </li>
                      <% }); %>
                    </ol>
                  </details>
                </td>
                <td><%= new Date(order.createdAt).toLocaleString('en-GB') %></td>
                <td>
                  <% const nextStatuses = orderStatusTransitions[order.orderStatus] || []; %>
                  <% if (nextStatuses.length > 0) { %>
                    <form class="quick-order-action order-status-form" data-order-id="<%= order._id %>">
                      <select name="status" aria-label="Next order status" required>
                        <option value="" selected disabled>Choose next status</option>
                        <% nextStatuses.forEach(function(status) { %>
                          <option value="<%= status %>"><%= orderStatusLabels[status] %></option>
                        <% }); %>
                      </select>
                      <button type="submit" class="btn-primary">Update</button>
                    </form>
                  <% } else { %>
                    <small>Final status</small>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <script>
    const message = document.getElementById("order-message");
    const orderStatusLabels = {
      PENDING: "Pending",
      CONFIRMED: "Confirmed",
      BAKING: "Baking",
      DECORATING: "Decorating",
      OUT_FOR_DELIVERY: "Out for delivery",
      CANCELLED: "Cancelled",
      DELIVERED: "Delivered",
    };
    const orderStatusTransitions = {
      PENDING: ["CONFIRMED", "CANCELLED"],
      PROCESS: ["CONFIRMED"],
      CONFIRMED: ["BAKING", "CANCELLED"],
      BAKING: ["DECORATING", "CANCELLED"],
      DECORATING: ["OUT_FOR_DELIVERY", "CANCELLED"],
      OUT_FOR_DELIVERY: ["DELIVERED"],
      DELIVERED: [],
      CANCELLED: [],
    };

    document.querySelectorAll(".order-status-form").forEach(function(form) {
      form.addEventListener("submit", async function(event) {
        event.preventDefault();
        const button = form.querySelector("button");
        const select = form.querySelector("select");
        const orderId = form.dataset.orderId;
        button.disabled = true;
        button.textContent = "Saving...";
        message.hidden = true;

        try {
          const response = await fetch(`/admin/orders/${orderId}/status`, {
            method: "PATCH",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ status: select.value }),
          });
          const result = await response.json();
          if (!response.ok) throw new Error(result.message);

          const badge = document.getElementById(`status-${orderId}`);
          badge.textContent = orderStatusLabels[result.data.orderStatus] || result.data.orderStatus;
          badge.className = `status-badge status-${result.data.orderStatus.toLowerCase().replaceAll("_", "-")}`;
          const nextStatuses = orderStatusTransitions[result.data.orderStatus] || [];
          select.replaceChildren();
          if (nextStatuses.length > 0) {
            const placeholder = document.createElement("option");
            placeholder.value = "";
            placeholder.textContent = "Choose next status";
            placeholder.disabled = true;
            placeholder.selected = true;
            select.append(placeholder);
            nextStatuses.forEach(function(status) {
              const option = document.createElement("option");
              option.value = status;
              option.textContent = orderStatusLabels[status] || status;
              select.append(option);
            });
          } else {
            select.disabled = true;
            button.disabled = true;
            button.textContent = "Final status";
          }
          const history = document.getElementById(`history-${orderId}`);
          const latestEntry = result.data.statusHistory?.at(-1);
          if (history && latestEntry) {
            const item = document.createElement("li");
            const title = document.createElement("strong");
            const detail = document.createElement("span");
            title.textContent = orderStatusLabels[latestEntry.status] || latestEntry.status;
            detail.textContent = `${latestEntry.source} · ${new Date(latestEntry.changedAt).toLocaleString("en-GB")}`;
            item.append(title, detail);
            history.append(item);
            const summary = history.closest("details")?.querySelector("summary");
            if (summary) summary.textContent = `History (${history.children.length})`;
          }
          message.textContent = result.message;
          message.className = "order-message order-message-success";
          message.hidden = false;
        } catch (error) {
          message.textContent = error.message || "Unable to update the order status.";
          message.className = "order-message order-message-error";
          message.hidden = false;
        } finally {
          if (!select.disabled) {
            button.disabled = false;
            button.textContent = "Update";
          }
        }
      });
    });
  </script>
</body>
</html>
