<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Sweet Shop Admin - Products</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-page">
 <%- include('includes/header') %>

  <!-- <div class="floating-sweet">🧁</div> -->
   <div class="floating-sweet fs4">🍪</div>
  <div class="floating-sweet fs2">🍰</div>
  <div class="floating-sweet fs3">🎂</div>
  <div class="floating-sweet fs4">🍪</div>
  <div class="floating-sweet fs2">🍰</div>

  <main class="container products-page">
    <div class="page-heading">
      <div>
        <p class="eyebrow">Admin panel</p>
        <h1>Products</h1>
        <p class="page-description">View store products and manage their availability.</p>
      </div>
      <button class="btn-primary add-product-button" type="button" onclick="toggleForm()">+ Add product</button>
    </div>

    <div class="table-card">
      <div class="table-scroll">
    <table class="products-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Category</th>
          <th>Price</th>
          <th>Views</th>
          <th>Status</th>
          <th>Image</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% products.forEach(function(product) { %>
          <tr>
            <td><%= product.productName %></td>
            <td><%= product.productCategory %></td>
            <td><%= product.productPrice %> UZS</td>
            <td><%= product.productViews %></td>
            <td><%= product.productStatus %></td>
            <td>
              <% if (product.productImage) { %>
                <div class="product-image-frame">
                  <img
                    src="/uploads/<%= product.productImage %>"
                    class="product-thumb"
                    alt="<%= product.productName %>"
                    loading="lazy"
                  >
                </div>
              <% } else { %>
                <span class="no-image">No image</span>
              <% } %>
            </td>
            <td>
              <button
                type="button"
                class="btn-edit"
                data-product-id="<%= product._id %>"
                data-product-name="<%= product.productName %>"
                data-product-price="<%= product.productPrice %>"
                data-product-category="<%= product.productCategory %>"
                data-product-desc="<%= product.productDesc || '' %>"
                data-product-image="<%= product.productImage || '' %>"
                onclick="openEditForm(this)"
              >Edit</button>
              <div class="status-dropdown">
                <button type="button" class="btn-status-toggle" onclick="toggleDropdown('dropdown-<%= product._id %>')">Status ▾</button>
                <div id="dropdown-<%= product._id %>" class="dropdown-menu">
                  <form action="/admin/products/<%= product._id %>/status" method="POST">
                    <input type="hidden" name="status" value="PROCESS">
                    <button type="submit">Activate</button>
                  </form>
                  <form action="/admin/products/<%= product._id %>/status" method="POST">
                    <input type="hidden" name="status" value="PAUSE">
                    <button type="submit">Pause</button>
                  </form>
                  <form action="/admin/products/<%= product._id %>/status" method="POST">
                    <input type="hidden" name="status" value="SOLD_OUT">
                    <button type="submit">Sold out</button>
                  </form>
                  <form action="/admin/products/<%= product._id %>/status" method="POST">
                    <input type="hidden" name="status" value="DELETE">
                    <button type="submit">Delete</button>
                  </form>
                </div>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
      </div>
    </div>

    <div id="editForm" class="edit-product-panel" hidden>
      <form id="editProductForm" enctype="multipart/form-data">
        <h2>Edit product</h2>
        <div id="editProductError" class="create-form-error" role="alert" hidden></div>

        <label for="editProductName">Name:</label>
        <input id="editProductName" type="text" name="productName" required>

        <label for="editProductPrice">Price:</label>
        <input id="editProductPrice" type="number" name="productPrice" min="0" required>

        <label for="editProductCategory">Category:</label>
        <select id="editProductCategory" name="productCategory" required>
          <option value="CUPCAKE">CUPCAKE</option>
          <option value="CAKE">CAKE</option>
          <option value="BIRTHDAY_CAKE">BIRTHDAY CAKE</option>
          <option value="COOKIE">COOKIE</option>
          <option value="OTHER">OTHER</option>
        </select>

        <label for="editProductDesc">Description:</label>
        <textarea id="editProductDesc" name="productDesc"></textarea>

        <label for="editProductImage">New image (optional):</label>
        <input id="editProductImage" type="file" name="productImage" accept="image/png,image/jpeg,image/webp">
        <small id="currentProductImage"></small>

        <div class="button-row">
          <button id="editSubmitButton" type="submit" class="btn-create">Save changes</button>
          <button type="button" class="btn-cancel" onclick="closeEditForm()">Cancel</button>
        </div>
      </form>
    </div>

    <div id="createForm" <%= createError ? '' : 'hidden' %>>
      <form action="/admin/products/create" method="POST" enctype="multipart/form-data">
        <% if (createError) { %>
          <div class="create-form-error" role="alert">
            <strong>Product could not be created.</strong>
            <span><%= createError %></span>
          </div>
        <% } %>

        <label>Name:</label>
        <input type="text" name="productName" value="<%= formData.productName || '' %>" required>

        <label>Price:</label>
        <input type="number" name="productPrice" value="<%= formData.productPrice || '' %>" required>

        <label>Category:</label>
        <select name="productCategory">
          <option value="CUPCAKE" <%= formData.productCategory === 'CUPCAKE' ? 'selected' : '' %>>CUPCAKE</option>
          <option value="CAKE" <%= formData.productCategory === 'CAKE' ? 'selected' : '' %>>CAKE</option>
          <option value="BIRTHDAY_CAKE" <%= formData.productCategory === 'BIRTHDAY_CAKE' ? 'selected' : '' %>>BIRTHDAY CAKE</option>
          <option value="COOKIE" <%= formData.productCategory === 'COOKIE' ? 'selected' : '' %>>COOKIE</option>
          <option value="OTHER" <%= formData.productCategory === 'OTHER' ? 'selected' : '' %>>OTHER</option>
        </select>

        <label>Description:</label>
        <textarea name="productDesc"><%= formData.productDesc || '' %></textarea>

        <label>Image:</label>
        <div class="image-upload" id="imageUpload">
          <input
            id="productImage"
            class="image-upload-input"
            type="file"
            name="productImage"
            accept="image/png,image/jpeg,image/webp"
          >
          <label class="image-upload-label" for="productImage">
            <span class="image-upload-icon" aria-hidden="true">↑</span>
            <span class="image-upload-copy">
              <strong>Choose an image</strong>
              <small>PNG, JPG or WEBP</small>
            </span>
          </label>
          <div class="image-preview" id="imagePreview" hidden>
            <img id="imagePreviewImg" src="" alt="Selected product preview">
            <div class="image-preview-info">
              <strong id="imageFileName"></strong>
              <span>Image selected successfully</span>
              <button type="button" class="image-change-button" id="imageChangeButton">Choose another</button>
            </div>
          </div>
        </div>

        <br><br>
        <button type="submit" class="btn-create">Create</button>
        <button type="button" class="btn-cancel" onclick="toggleForm()">Cancel</button>
      </form>
    </div>
  </main>

  <script>
    const editPanel = document.getElementById("editForm");
    const editProductForm = document.getElementById("editProductForm");
    const editProductError = document.getElementById("editProductError");
    let editingProductId = "";

    function openEditForm(button) {
      editingProductId = button.dataset.productId;
      document.getElementById("editProductName").value = button.dataset.productName;
      document.getElementById("editProductPrice").value = button.dataset.productPrice;
      document.getElementById("editProductCategory").value = button.dataset.productCategory;
      document.getElementById("editProductDesc").value = button.dataset.productDesc;
      document.getElementById("editProductImage").value = "";
      document.getElementById("currentProductImage").textContent = button.dataset.productImage
        ? `Current image: ${button.dataset.productImage}`
        : "No current image";
      editProductError.hidden = true;
      editPanel.hidden = false;
      editPanel.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    function closeEditForm() {
      editPanel.hidden = true;
      editingProductId = "";
      editProductForm.reset();
    }

    editProductForm.addEventListener("submit", async function(event) {
      event.preventDefault();
      if (!editingProductId) return;

      const submitButton = document.getElementById("editSubmitButton");
      submitButton.disabled = true;
      submitButton.textContent = "Saving...";
      editProductError.hidden = true;

      try {
        const response = await fetch(`/admin/products/${editingProductId}`, {
          method: "PATCH",
          body: new FormData(editProductForm),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.message);
        window.location.reload();
      } catch (error) {
        editProductError.textContent = error.message || "Unable to update the product.";
        editProductError.hidden = false;
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = "Save changes";
      }
    });

    function toggleForm() {
      const form = document.getElementById("createForm");
      form.hidden = !form.hidden;
    }

    function toggleDropdown(id) {
      const menu = document.getElementById(id);
      const isOpen = menu.style.display === "block";
      document.querySelectorAll(".dropdown-menu").forEach(function(m) {
        m.style.display = "none";
      });
      menu.style.display = isOpen ? "none" : "block";
    }

    document.addEventListener("click", function(e) {
      if (!e.target.closest(".status-dropdown")) {
        document.querySelectorAll(".dropdown-menu").forEach(function(m) {
          m.style.display = "none";
        });
      }
    });

    const imageInput = document.getElementById("productImage");
    const imageUploadLabel = document.querySelector(".image-upload-label");
    const imagePreview = document.getElementById("imagePreview");
    const imagePreviewImg = document.getElementById("imagePreviewImg");
    const imageFileName = document.getElementById("imageFileName");
    const imageChangeButton = document.getElementById("imageChangeButton");
    let previewUrl;

    imageInput.addEventListener("change", function() {
      const file = imageInput.files[0];
      if (!file) return;

      if (previewUrl) URL.revokeObjectURL(previewUrl);
      previewUrl = URL.createObjectURL(file);
      imagePreviewImg.src = previewUrl;
      imageFileName.textContent = file.name;
      imageUploadLabel.hidden = true;
      imagePreview.hidden = false;
    });

    imageChangeButton.addEventListener("click", function() {
      imageInput.click();
    });

    window.addEventListener("beforeunload", function() {
      if (previewUrl) URL.revokeObjectURL(previewUrl);
    });
  </script>
</body>
</html>
