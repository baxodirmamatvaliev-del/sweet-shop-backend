<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8">
  <title>Sweet Shop Admin - Mahsulotlar</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-page">

  <div class="floating-sweet">🧁</div>
   <div class="floating-sweet fs4">🍪</div>
  <div class="floating-sweet fs2">🍰</div>
  <div class="floating-sweet fs3">🎂</div>
  <div class="floating-sweet fs4">🍪</div>
  <div class="floating-sweet fs2">🍰</div>

  <div class="container">
    <h1>Mahsulotlar ro'yxati</h1>

    <table border="1" cellpadding="10">
      <thead>
        <tr>
          <th>Nomi</th>
          <th>Kategoriya</th>
          <th>Narxi</th>
          <th>Ko'rishlar</th>
          <th>Status</th>
          <th>Rasm</th>
          <th>Amallar</th>
        </tr>
      </thead>
      <tbody>
        <% products.forEach(function(product) { %>
          <tr>
            <td><%= product.productName %></td>
            <td><%= product.productCategory %></td>
            <td><%= product.productPrice %> so'm</td>
            <td><%= product.productViews %></td>
            <td><%= product.productStatus %></td>
            <td>
              <% if (product.productImage) { %>
                <img src="/uploads/<%= product.productImage %>" class="product-thumb">
              <% } else { %>
                <span>Rasm yo'q</span>
              <% } %>
            </td>
            <td>
              <div class="status-dropdown">
                <button type="button" class="btn-status-toggle" onclick="toggleDropdown('dropdown-<%= product._id %>')">Status ▾</button>
                <div id="dropdown-<%= product._id %>" class="dropdown-menu">
                  <form action="/admin/products/<%= product._id %>/status" method="POST">
                    <input type="hidden" name="status" value="PROCESS">
                    <button type="submit">Faollashtirish</button>
                  </form>
                  <form action="/admin/products/<%= product._id %>/status" method="POST">
                    <input type="hidden" name="status" value="PAUSE">
                    <button type="submit">Pauza</button>
                  </form>
                  <form action="/admin/products/<%= product._id %>/status" method="POST">
                    <input type="hidden" name="status" value="SOLD_OUT">
                    <button type="submit">Tugagan</button>
                  </form>
                  <form action="/admin/products/<%= product._id %>/status" method="POST">
                    <input type="hidden" name="status" value="DELETE">
                    <button type="submit">O'chirish</button>
                  </form>
                </div>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>

    <div class="button-row">
      <button class="btn-primary" type="button" onclick="toggleForm()">New Product button🛎️</button>
    </div>

    <div id="createForm" style="display:none;">
      <form action="/admin/products/create" method="POST" enctype="multipart/form-data">
        <label>Nomi:</label>
        <input type="text" name="productName" required>

        <label>Narxi:</label>
        <input type="number" name="productPrice" required>

        <label>Kategoriya:</label>
        <select name="productCategory">
          <option value="CUPCAKE">CUPCAKE</option>
          <option value="CAKE">CAKE</option>
          <option value="COOKIE">COOKIE</option>
          <option value="OTHER">OTHER</option>
        </select>

        <label>Tavsif:</label>
        <textarea name="productDesc"></textarea>

        <label>Rasm:</label>
        <input type="file" name="productImage">

        <br><br>
        <button type="submit" class="btn-create">Create</button>
        <button type="button" class="btn-cancel" onclick="toggleForm()">Cancel</button>
      </form>
    </div>
  </div>

  <script>
    function toggleForm() {
      const form = document.getElementById("createForm");
      form.style.display = form.style.display === "none" ? "block" : "none";
    }

    function toggleDropdown(id) {
      const menu = document.getElementById(id);
      const isOpen = menu.style.display === "block";
      document.querySelectorAll(".dropdown-menu").forEach(function(m) {
        m.style.display = "none";
      });
      menu.style.display = isOpen ? "none" : "block";
    }

    document.addEventListener("click", function(e) {
      if (!e.target.closest(".status-dropdown")) {
        document.querySelectorAll(".dropdown-menu").forEach(function(m) {
          m.style.display = "none";
        });
      }
    });
  </script>
</body>
</html>