<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8">
  <title>Sweet Shop Admin - Kirish</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="login-page">

  <video autoplay muted loop class="bg-video">
    <source src="/videos/login.page.video.mp4" type="video/mp4">
  </video>

  <div class="overlay"></div>

  <div class="login-box">
    <h1>Admin panelga kirish</h1>

    <% if (error) { %>
      <p style="color:red;"><%= error %></p>
    <% } %>

    <form action="/admin/login" method="POST">
      <label>Login:</label>
      <input type="text" name="memberNick" required>

      <label>Parol:</label>
      <input type="password" name="memberPassword" required>

      <br><br>
      <button type="submit" class="btn-create">Kirish</button>
    </form>
  </div>
</body>
</html>