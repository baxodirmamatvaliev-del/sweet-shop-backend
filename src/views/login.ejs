<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Morrow Coffee Admin - Sign in</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="login-page">


  <div class="login-box">
    <img class="login-brand" src="/img/morrow-coffee-logo.svg" width="240" height="61" alt="Morrow Coffee">
    <h1>Sign in to the admin panel</h1>

    <% if (error) { %>
      <p class="form-alert form-alert-error"><%= error %></p>
    <% } %>

    <% if (typeof registered !== 'undefined' && registered) { %>
      <p class="form-alert form-alert-success">Your account has been created. An administrator must grant access before you can sign in here.</p>
    <% } %>

    <form action="/admin/login" method="POST">
      <label>Username:</label>
      <input type="text" name="memberNick" required>

      <label>Password:</label>
      <input type="password" name="memberPassword" required>

      <br><br>
      <button type="submit" class="btn-create">Sign in</button>
    </form>

    <p class="login-signup-link">Need an account? <a href="/admin/signup">Create one</a></p>
  </div>
</body>
</html>
